[user]
	name = Nick Spaargaren
	email = nickspaargaren@users.noreply.github.com
	signingkey = /Users/nick/.ssh/id_ed25519.pub

[alias]
    # View the SHA, description, and history graph of the latest 30 commits
    l = log --pretty=oneline -n 30 --graph --abbrev-commit

    # Pull the latest changes on the origin
    po = !zsh -ic 'ggpull'

    # Push commits to the current local branch
    pc = push origin HEAD

[color]
    ui = auto

[color "branch"]
    current = green
    local = yellow
    remote = red

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

[core]
    editor = vim

[rerere]
    enabled = true
    autoupdate = true

[pager]
    branch = false
    log = false
    tag = false
[gpg]
	format = ssh
[commit]
	gpgsign = true
